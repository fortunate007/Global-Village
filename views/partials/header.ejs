<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · <%= appName %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <a href="/account/delete">Delete my account</a>
  <a href="/account/export">Download my data</a>
  <a href="/account/security">Password and devices</a>
  <% if (emailPending) { %>
  <p class="notice">Please confirm your email address. <a href="/account/verify-email">Resend the link or fix a typo</a>.</p>
<% } %>
  <header class="topbar">
    <a class="brand" href="/">
      <span class="brand-mark">GV</span>
      <span class="brand-name"><%= appName %></span>
    </a>
    <% if (currentUser) { %>
      <nav class="topnav">
        <% if (currentUser && currentUser.is_admin) { %>
  <a href="/admin/users">Admin</a>
<% } %>
        <a href="/users">People</a>
        <a href="/friends">Friends<% if (pendingRequests > 0) { %> <span class="badge"><%= pendingRequests %></span><% } %></a>
        <a href="/groups/new">New Group</a>
        <a href="/profile">Edit Profile</a>
        <a class="me" href="/profile/<%= currentUser.id %>">
          <img class="avatar avatar-sm" src="<%= currentUser.avatar_url %>" alt="" />
          <%= currentUser.display_name %>
        </a>
        <form action="/logout" method="POST" class="inline-form">
          <button type="submit" class="link-btn">Log out</button>
        </form>
      </nav>
    <% } %>
  </header>
  <main class="container">
    <% if (typeof successMsg !== 'undefined' && successMsg.length) { %>
      <div class="flash flash-success"><%= successMsg[0] %></div>
    <% } %>
    <% if (typeof errorMsg !== 'undefined' && errorMsg.length) { %>
      <div class="flash flash-error"><%= errorMsg[0] %></div>
    <% } %>
