<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · <%= appName %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <script src="/js/usermenu.js" defer></script>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <% if (locals.emailPending) { %>
  <p class="notice">Please confirm your email address. <a href="/account/verify-email">Resend the link or fix a typo</a>.</p>
<% } %>
  <header class="topbar">
    <a class="brand" href="/">
      <span class="brand-mark">GV</span>
      <span class="brand-name"><%= appName %></span>
    </a>
    <% if (currentUser) { %>
      <nav class="topnav">
        <% if (currentUser && currentUser.is_admin) { %>
  <a href="/admin/users">Admin</a>
<% } %>
        <a href="/users">People</a>
        <a href="/tags">Trends</a>
        <a href="/search">Search</a>
        <a href="/notifications">Notifications <span data-notification-badge><% if (locals.unreadNotifications) { %>(<%= locals.unreadNotifications %>)<% } %></span></a>
        <a href="/friends">Friends<% if (pendingRequests > 0) { %> <span class="badge"><%= pendingRequests %></span><% } %></a>
        <a href="/groups/new">New Group</a>
        <details class="usermenu">
          <summary class="me">
            <img class="avatar avatar-sm" src="<%= currentUser.avatar_url %>" alt="" />
            <%= currentUser.display_name %>
            <span class="caret" aria-hidden="true">▾</span>
          </summary>
          <div class="menu-panel">
            <a href="/profile/<%= currentUser.id %>">View profile</a>
            <a href="/profile">Edit profile</a>
            <a href="/bookmarks">Bookmarks</a>
            <a href="/mentions">Mentions</a>
            <a href="/account/security">Password and devices</a>
            <a href="/account/verify-email">Email address</a>
            <a href="/account/phone">Phone number</a>
            <a href="/safety">Blocked and muted</a>
            <a href="/account/export">Download my data</a>
            <hr />
            <form action="/logout" method="POST">
              <button type="submit">Log out</button>
            </form>
            <hr />
            <a class="danger" href="/account/delete">Delete my account</a>
          </div>
        </details>
      </nav>
    <% } %>
  </header>
  <%- include('sidebar') %>
  <main class="container">
    <% if (typeof successMsg !== 'undefined' && successMsg.length) { %>
      <div class="flash flash-success"><%= successMsg[0] %></div>
    <% } %>
    <% if (typeof errorMsg !== 'undefined' && errorMsg.length) { %>
      <div class="flash flash-error"><%= errorMsg[0] %></div>
    <% } %>
