<%- include('../partials/header') %>
<main>
  <h2>Reset your password by text message</h2>
  <p>Choose the country and enter the phone number you verified on your account. If it matches, we will text you a code.</p>
  <form method="POST" action="/forgot-password/phone">
    <label>Country
      <%- include('_country-select', { selected: defaultPhoneCountry }) %>
    </label>
    <label>Phone number
      <input type="tel" name="phone" required maxlength="30" autocomplete="tel-national" placeholder="Number, or the full number starting with +" autofocus>
    </label>
    <button>Send code</button>
    <a href="/forgot-password">Use email instead</a>
  </form>
</main>
<%- include('../partials/footer') %>
