<%- include('partials/header') %>

<div class="auth-card wide">
  <h1>Edit your profile</h1>
  <a href="/account/delete">Delete my account</a>
  <a href="/account/export">Download my data</a>

  <form action="/profile" method="POST" enctype="multipart/form-data" class="stack-form">
    <div class="avatar-editor">
      <img class="avatar avatar-lg" src="<%= me.avatar_url %>" alt="" />
      <div>
        <label for="avatar">Avatar</label>
        <input type="file" id="avatar" name="avatar" accept="image/*" />
      </div>
    </div>

    <label for="displayName">Display name</label>
    <input type="text" id="displayName" name="displayName" value="<%= me.display_name %>" required />

    <label for="statusMessage">Status message</label>
    <input type="text" id="statusMessage" name="statusMessage" maxlength="80"
      placeholder="e.g. Building cool things" value="<%= me.status_message %>" />

    <label for="bio">Bio</label>
    <textarea id="bio" name="bio" rows="5" maxlength="500" placeholder="Tell people about yourself"><%= me.bio %></textarea>

    <button type="submit" class="btn btn-primary">Save changes</button>
  </form>
</div>

<%- include('partials/footer') %>
