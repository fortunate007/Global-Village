<%- include('partials/header') %>

<div class="chat-shell">
  <div class="chat-header">
    <% if (chatType === 'dm') { %>
      <img class="avatar" src="<%= other.avatar_url %>" alt="" />
      <div>
        <h1><a href="/profile/<%= other.id %>"><%= other.display_name %></a></h1>
        <p class="tile-sub">@<%= other.username %></p>
      </div>
    <% } else { %>
      <img class="avatar" src="<%= group.avatar_url %>" alt="" />
      <div>
        <h1><%= group.name %></h1>
        <p class="tile-sub">
          <%= group.members.length %> members:
          <%= group.members.map(function(m){ return m.display_name }).join(', ') %>
        </p>
      </div>
    <% } %>
  </div>

  <div class="message-list" id="message-list">
    <% messages.forEach(function(m) { %>
      <div class="message <%= m.sender_id === currentUser.id ? 'mine' : '' %>" data-id="<%= m.id %>">
        <img class="avatar avatar-sm" src="<%= m.sender_avatar %>" alt="" />
        <div class="bubble">
          <% if (chatType === 'group' && m.sender_id !== currentUser.id) { %>
            <div class="bubble-sender"><%= m.sender_name %></div>
          <% } %>
          <% if (m.deleted_at) { %>
            <div class="bubble-text bubble-deleted">Message deleted</div>
          <% } else { %>
            <% if (m.body) { %><div class="bubble-text"><%= m.body %></div><% } %>
            <% if (m.image_url) { %><img class="bubble-image" src="<%= m.image_url %>" alt="Shared image" /><% } %>
          <% } %>
          <div class="bubble-time">
            <%= new Date(m.created_at + 'Z').toLocaleString() %>
            <% if (m.edited_at && !m.deleted_at) { %><span class="bubble-edited">(edited)</span><% } %>
          </div>
          <% if (m.sender_id === currentUser.id && !m.deleted_at && chatType === 'dm') { %>
            <div class="bubble-actions">
              <button type="button" class="link-btn edit-msg-btn" data-id="<%= m.id %>" data-body="<%= m.body %>">Edit</button>
              <form action="/messages/<%= chatTargetId %>/<%= m.id %>/delete" method="POST" class="inline-form">
                <button type="submit" class="link-btn" onclick="return confirm('Delete this message?')">Delete</button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>

  <form
    class="chat-form"
    action="<%= chatType === 'dm' ? '/messages/' + chatTargetId : '/groups/' + chatTargetId %>"
    method="POST"
    enctype="multipart/form-data"
  >
    <input type="text" name="body" placeholder="Type a message&hellip;" autocomplete="off" autofocus />
    <label class="file-btn" title="Attach an image">
      📎<input type="file" name="image" accept="image/*" />
    </label>
    <button type="submit" class="btn btn-primary">Send</button>
  </form>

  <form id="edit-message-form" class="chat-form edit-form" method="POST" style="display:none;">
    <input type="text" name="body" id="edit-message-input" autocomplete="off" />
    <button type="submit" class="btn btn-primary">Save</button>
    <button type="button" id="edit-message-cancel" class="btn btn-secondary">Cancel</button>
  </form>
</div>

<script>
  const chatType = <%- JSON.stringify(chatType) %>;
  const targetId = <%- JSON.stringify(chatTargetId) %>;
  const myId = <%- JSON.stringify(currentUser.id) %>;
  const list = document.getElementById('message-list');
  list.scrollTop = list.scrollHeight;

  function lastMessageId() {
    const items = list.querySelectorAll('.message');
    if (!items.length) return 0;
    return Number(items[items.length - 1].dataset.id) || 0;
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function renderMessage(m) {
    const mine = m.sender_id === myId;
    const wrap = document.createElement('div');
    wrap.className = 'message' + (mine ? ' mine' : '');
    wrap.dataset.id = m.id;

    const senderLine =
      chatType === 'group' && !mine
        ? `<div class="bubble-sender">${escapeHtml(m.sender_name)}</div>`
        : '';
    const textLine = m.body ? `<div class="bubble-text">${escapeHtml(m.body)}</div>` : '';
    const imageLine = m.image_url
      ? `<img class="bubble-image" src="${m.image_url}" alt="Shared image" />`
      : '';
    const time = new Date(m.created_at + 'Z').toLocaleString();

    wrap.innerHTML = `
      <img class="avatar avatar-sm" src="${m.sender_avatar}" alt="" />
      <div class="bubble">
        ${senderLine}
        ${textLine}
        ${imageLine}
        <div class="bubble-time">${time}</div>
      </div>`;
    return wrap;
  }

  async function poll() {
    try {
      const base = chatType === 'dm' ? `/api/messages/${targetId}` : `/api/groups/${targetId}`;
      const res = await fetch(`${base}/since/${lastMessageId()}`);
      const newMessages = await res.json();
      if (newMessages.length) {
        const wasAtBottom = list.scrollHeight - list.scrollTop - list.clientHeight < 60;
        newMessages.forEach((m) => list.appendChild(renderMessage(m)));
        if (wasAtBottom) list.scrollTop = list.scrollHeight;
      }
    } catch (e) { /* ignore transient errors */ }
  }
  setInterval(poll, 3000);

  // Inline message editing (DM chats only, since edit routes are DM-only for now)
  if (chatType === 'dm') {
    const editForm = document.getElementById('edit-message-form');
    const editInput = document.getElementById('edit-message-input');
    const cancelBtn = document.getElementById('edit-message-cancel');
    const sendForm = document.querySelector('.chat-form:not(.edit-form)');

    list.addEventListener('click', (e) => {
      const btn = e.target.closest('.edit-msg-btn');
      if (!btn) return;
      const id = btn.dataset.id;
      editForm.action = `/messages/${targetId}/${id}/edit`;
      editInput.value = btn.dataset.body;
      editForm.style.display = 'flex';
      sendForm.style.display = 'none';
      editInput.focus();
    });

    cancelBtn.addEventListener('click', () => {
      editForm.style.display = 'none';
      sendForm.style.display = 'flex';
    });
  }
</script>

<%- include('partials/footer') %>
